# Todas as variáveis são opcionais — o app sobe sem nenhuma delas.
# Para usar: cp .env.example .env.local

# Origem dos dados. Aponte para um mock se quiser rodar offline.
RICK_AND_MORTY_API_URL=https://rickandmortyapi.com/api
UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_RETRIES=3

# true gera build standalone (imagem enxuta para container).
BUILD_STANDALONE=false
