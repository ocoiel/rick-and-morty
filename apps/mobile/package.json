{
  "name": "@zrp/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node --experimental-strip-types scripts/sync-tokens.ts",
    "build": "flutter build web --release",
    "pretest": "node --experimental-strip-types scripts/sync-tokens.ts",
    "test": "flutter test --coverage",
    "prelint": "node --experimental-strip-types scripts/sync-tokens.ts",
    "lint": "flutter analyze",
    "codegen": "dart run swagger_parser && dart run build_runner build",
    "dev": "flutter run -d chrome"
  },
  "devDependencies": {
    "@zrp/design-tokens": "workspace:*"
  }
}
