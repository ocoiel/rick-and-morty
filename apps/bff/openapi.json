{
  "openapi": "3.1.0",
  "info": {
    "title": "Rick and Morty — elenco por episódio",
    "description": "Contrato consumido pelo app Flutter e por qualquer outro cliente.",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Character": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Alive",
              "Dead",
              "unknown"
            ]
          },
          "species": {
            "type": "string"
          },
          "gender": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "species",
          "gender",
          "origin",
          "location",
          "imageUrl"
        ],
        "additionalProperties": false
      },
      "EpisodeList": {
        "type": "object",
        "properties": {
          "episodes": {
            "readOnly": true,
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "required": [
          "episodes"
        ],
        "additionalProperties": false
      },
      "EpisodeCast": {
        "type": "object",
        "properties": {
          "episode": {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "airDate": {
                "type": "string"
              }
            },
            "required": [
              "number",
              "name",
              "code",
              "airDate"
            ],
            "additionalProperties": false
          },
          "characters": {
            "readOnly": true,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Character"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "source": {
                "type": "string",
                "enum": [
                  "cache",
                  "origin"
                ]
              }
            },
            "required": [
              "total",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "episode",
          "characters",
          "meta"
        ],
        "additionalProperties": false
      },
      "CharacterAppearances": {
        "type": "object",
        "properties": {
          "characterId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "episodes": {
            "readOnly": true,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "code": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "number",
                "code",
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "characterId",
          "episodes"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "uptime": {
            "type": "number"
          }
        },
        "required": [
          "status",
          "uptime"
        ],
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "INVALID_EPISODE_NUMBER | EPISODE_NOT_FOUND | UPSTREAM_UNAVAILABLE | ROUTE_NOT_FOUND | INTERNAL_ERROR"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Verificação de disponibilidade.",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/episodes": {
      "get": {
        "operationId": "listEpisodes",
        "summary": "Lista os números de episódio disponíveis.",
        "tags": [
          "episodes"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EpisodeList"
                }
              }
            }
          },
          "502": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/episodes/{id}/cast": {
      "get": {
        "operationId": "getEpisodeCast",
        "summary": "Elenco do episódio, em ordem alfabética.",
        "tags": [
          "episodes"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Identificador numérico do recurso."
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EpisodeCast"
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/characters/{id}/episodes": {
      "get": {
        "operationId": "getCharacterAppearances",
        "summary": "Episódios em que o personagem aparece.",
        "tags": [
          "characters"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Identificador numérico do recurso."
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CharacterAppearances"
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "episodes",
      "description": "Episódios e seus elencos."
    },
    {
      "name": "characters",
      "description": "Personagens e suas aparições."
    },
    {
      "name": "health",
      "description": "Disponibilidade do serviço."
    }
  ]
}
