# Todas as variáveis são opcionais — o BFF sobe sem nenhuma delas.
# Para usar: cp .env.example .env

HOST=0.0.0.0
PORT=3333

# Origem dos dados. Aponte para um mock se quiser rodar offline.
RICK_AND_MORTY_API_URL=https://rickandmortyapi.com/api
UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_RETRIES=3

# false desliga o cache em memória (útil para depurar a origem).
CACHE_ENABLED=true

CORS_ORIGIN=*
LOG_LEVEL=info
