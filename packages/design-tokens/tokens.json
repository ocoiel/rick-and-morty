    "surface": "#0e1319",
    "surface-raised": "#151c24",
    "border": "#1f2933",
    "border-strong": "#2d3a47",
    "portal": "#7fd14a",
    "portal-bright": "#a5f065",
    "portal-dim": "#3f6b24",
